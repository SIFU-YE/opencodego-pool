# ⚠️ 旧版 unit（历史部署沿用）：独立部署请用 deploy/systemd/opencodelitelm-pool-dashboard.service
#    本文件保留为旧机兼容；路径改用 ${POOL_HOME}（默认 /opt/litellm）。
#    安全模型不变：看板默认只监听 127.0.0.1，没有内置账号体系（旧机上的 Halo 门禁由 nginx 负责）。
#
# 安装（旧机）：
#   install -m 644 pool/systemd/pool-dash.service /etc/systemd/system/
#   /etc/opencodelitelm-pool.env 写入 POOL_HOME=/opt/litellm、POOL_DASHBOARD_PORT=4010
#   systemctl daemon-reload && systemctl enable --now pool-dash

[Unit]
Description=OpenCode Go pool dashboard (127.0.0.1:4010, legacy unit)
After=network.target docker.service

[Service]
Type=simple
EnvironmentFile=-/etc/opencodelitelm-pool.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 ${POOL_HOME}/dashboard.py --listen 127.0.0.1:${POOL_DASHBOARD_PORT}
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
