# OpencodeLitellmPool · 运行期环境变量模板
#
# 用途：部署时由 deploy/bootstrap.sh 复制为 ${POOL_HOME}/.env（默认 /opt/litellm/.env，权限 600），
#       再作为 LiteLLM 容器的 env_file 注入（容器 env 在 create 时固化，改完需重建容器）。
# 纪律：
#   · .env 绝不要提交（.gitignore 已覆盖）；日志/终端只打印 OCG_KEY_N 之类的引用名，不打印值；
#   · 示例值一律用 replace-me；留空/占位的 OCG_KEY_n 行会被 bootstrap 清理。
#
# 上游账号：每把 key 一个账号；号池按账号健康度与「额度临期烧量」份额做路由。
# 编号即槽号（N）：槽号参与会话/缓存身份，删除账号后不要复用旧编号。
OCG_KEY_1=
OCG_KEY_2=
OCG_KEY_3=
OCG_KEY_4=
OCG_KEY_5=
OCG_KEY_6=
# 示例：OCG_KEY_1=replace-me
# 需要更多账号时继续追加 OCG_KEY_7=… OCG_KEY_8=…（生成器按 OCG_KEY_<数字> 扫描）。

# 与 key 一一对应的账号标识（仅用于日志与看板展示，可填邮箱或别名，不参与鉴权）
OCG_EMAIL_1=
OCG_EMAIL_2=
OCG_EMAIL_3=
OCG_EMAIL_4=
OCG_EMAIL_5=
OCG_EMAIL_6=

# ---- 网关自身 ----
# LiteLLM 主键：只在号池内部使用，绝不下发给客户端（客户端用 sk-pool-* 实例键）。
# 留空或保持 replace-me 时，bootstrap.sh 会自动生成一把随机主键写入本文件（不打印）。
LITELLM_MASTER_KEY=

# 会话桶数量 K：同一会话树确定性命中同一桶（上游 x-opencode-session 分桶）。
# 必须与 gen_config.py 的 POOL_SESSION_BUCKETS 一致；改这个值会改变 deployment 矩阵，
# 需要重跑生成器并重启一次容器（部署期由 bootstrap 处理）。
POOL_SESSION_BUCKETS=8

# ---- 流式保活（session-sidecar，2026-10-17 起）----
# 上游会成簇地长静默（15 分钟窗口 p50 可从 7s 跳到 76–170s）；静默期 sidecar 若一个字节
# 都不发，客户端（DSH `streamIdleTimeoutMs`，默认调成 90s）会判「流空闲超时」并**直接失败**
# （retryPolicy.maxRetries=0，不重试），而号池侧请求其实最终是 200。
# 因此 sidecar 在静默期给客户端补 SSE 注释心跳 `: hb`（注释帧被 SSE 解析器忽略，不产生内容），
# 让客户端 idle 计时器看到"有字节"，请求该多慢就多慢、最后正常收尾。
# 改这两个值需重启 sidecar（`systemctl restart litellm-session-sidecar`）。
#   心跳间隔（秒）：必须远小于客户端 idle 阈值；0 = 关闭心跳
POOL_SSE_HEARTBEAT_S=15
#   连续静默上限（秒）：超过就主动断开，避免真卡死时客户端无限等待；0 = 不设上限
POOL_SSE_MAX_SILENCE_S=300

# ---- 可选：看板管理面 Host 白名单 ----
# 逗号分隔的主机名（如 pool.example.com,pool-admin.example），用于 /api/admin/* 的 Host 校验；
# 默认只接受 localhost / 127.0.0.1 / ::1。**这是 Host 白名单，不是身份认证**；
# 远程访问请仍自备 VPN / 反代鉴权。留空 = 仅本机。
#POOL_ADMIN_HOSTS=

# ---- 可选：容器出网代理（宿主机有 sing-box / 公司代理时用）----
# docker-host 由 docker-compose.yml 的 extra_hosts（host-gateway）映射到宿主网关，
# 无需写死 IP；也可以换成你自己的网关主机名/域名。
#HTTPS_PROXY=http://docker-host:<proxy-port>
#NO_PROXY=127.0.0.1,localhost

# ---- 可选：非 muse 模型的直连反代（2026-10-28 出口拆分）----
# 非 muse deployment 的 api_base 默认指向本机 http://localhost:4002 的 nginx 直连反代；
# 容器内访问宿主机时，把这两个变量指向宿主机 Docker 网关或 host-gateway 别名。
# 通道白名单由 pool/upstream_policy.py 从这两个变量推导，无需手改代码。
#POOL_DIRECT_OPENAI=http://<docker-host-gateway>:4002/inference/go/openai/v1
#POOL_DIRECT_ANTHROPIC=http://<docker-host-gateway>:4002/inference/go/anthropic
#POOL_EGRESS_MODELS=muse-spark

# ---- 预留 ----
# 上游 usage 查询地址（当前生成器内置规范端点，一般不需要改）
#OCG_USAGE_URL=https://opencode.ai/inference/go/v1/usage
