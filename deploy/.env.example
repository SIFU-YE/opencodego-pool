# OpencodeLitellmPool · 部署参数模板（deploy/.env）
#
# 用法：
#   cp deploy/.env.example deploy/.env   # bootstrap.sh 首次运行会自动做这一步
#   $EDITOR deploy/.env                  # 按需改路径/端口/镜像
#
# 这份文件只放「部署参数」，**不含任何密钥**：
#   上游账号 key / LiteLLM 主键 / 出网代理等运行时密钥 → 放 ${POOL_HOME}/.env
#   （由仓库根 .env.example 生成，权限 600，绝不入库）。
#
# deploy/.env 已被 .gitignore 的 `.env` 规则忽略；改完直接重跑 `sudo ./deploy/bootstrap.sh`。

# ---- 核心路径 ----
# 所有组件（config.yaml、.env、sidecar、看板、reconciler、运行时文件和日志）的家目录。
# 默认 /opt/litellm。注意：gen_config.py 与 dashboard.py 目前仍硬编码 /opt/litellm，
# 因此 POOL_HOME 取非默认值时 bootstrap 会创建兼容软链 `/opt/litellm -> $POOL_HOME`；
# 原生支持 POOL_HOME 是后续项（见 deploy/README.md「已知限制」）。
POOL_HOME=/opt/litellm

# ---- 容器与端口（默认只监听 127.0.0.1，不暴露到公网）----
# LiteLLM 镜像。想固定版本就换成具体 tag；升级镜像用 `sudo ./deploy/bootstrap.sh --pull`。
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
# LiteLLM 宿主端口（映射到容器内 4000），只绑回环。
LITELLM_PORT=4000
# 看板端口（`/` 驾驶舱，管理控制台是其内的一个页签），只绑回环。
DASHBOARD_PORT=4010
# session-sidecar 端口固定为 4001（脚本内硬编码），不提供变量。

# ---- 运行期 ----
# pool_reconciler.py 轮询间隔（秒）。它负责把 .env / allowlist 的变更热应用，
# 正常变更不需要重建或重启 litellm 容器。
RECONCILE_INTERVAL=60

# ---- 可选：只读份额引擎（默认不安装 systemd timer，也不会被启用）----
# 需要时：sudo systemctl enable --now opencodelitelm-pool-share-engine.timer
#SHARE_ENGINE_INTERVAL=600
